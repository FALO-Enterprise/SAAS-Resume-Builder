# Frontend sources (backend build only needs manifests for npm workspace resolution)
apps/frontend/*
!apps/frontend/package.json
!apps/frontend/tsconfig.json

# Backend runtime files
apps/backend/uploads/*
!apps/backend/uploads/.gitkeep

# Environment & OS files
**/.env
**/.env.*
!**/.env.example
.DS_Store
Thumbs.db
coverage
*.swp
*.swo
