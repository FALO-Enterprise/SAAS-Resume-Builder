{
  "name": "resumax",
  "version": "1.0.0",
  "private": true,
  "description": "Resumax - Resume builder platform monorepo",
  "packageManager": "npm@11.4.2",
  "workspaces": [
    "apps/frontend",
    "apps/backend",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "start": "turbo run start",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "clean": "node -e \"const fs=require('fs'); ['node_modules','apps/backend/node_modules','apps/frontend/node_modules'].forEach(path => fs.rmSync(path, { recursive: true, force: true }));\"",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "frontend": "npm --workspace apps/frontend run dev",
    "backend": "npm --workspace apps/backend run dev"
  },
  "devDependencies": {
    "prettier": "^3.0.0",
    "turbo": "^2.10.5"
  }
}
