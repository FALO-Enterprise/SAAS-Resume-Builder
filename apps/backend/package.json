{
  "name": "@resumax/backend",
  "version": "1.0.0",
  "private": true,
  "description": "Resumax backend API server",
  "main": "dist/server.js",
  "scripts": {
    "predev": "npm --workspace @resumax/shared-types run build",
    "dev": "tsx watch --include \"../../packages/shared-types/dist/**/*.js\" src/server.ts",
    "prisma:generate": "prisma generate",
    "prebuild": "npm run prisma:generate && npm --workspace @resumax/shared-types run build",
    "build": "tsc",
    "start": "node dist/server.js",
    "seed": "ts-node src/prisma/seed.ts",
    "lint": "eslint .",
    "pretype-check": "npm --workspace @resumax/shared-types run build",
    "type-check": "tsc --noEmit",
    "pretest": "npm --workspace @resumax/shared-types run build",
    "test": "tsx --test src/**/*.test.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@google/genai": "^2.15.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@resumax/shared-types": "*",
    "argon2": "^0.44.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "helmet": "^8.2.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.3",
    "pg": "^8.22.0",
    "prisma": "^7.8.0",
    "puppeteer": "^25.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@faker-js/faker": "^10.5.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.1.0",
    "@types/node": "^26.1.1",
    "@types/nodemailer": "^8.0.1",
    "eslint": "^9.39.4",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.63.0"
  }
}
